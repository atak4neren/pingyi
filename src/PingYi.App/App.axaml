<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PingYi.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PingYi.App/Localization/Strings.zh-CN.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBackgroundBrush">#F4F8F7</SolidColorBrush>
          <SolidColorBrush x:Key="CardBackgroundBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ElevatedBackgroundBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SubtleBackgroundBrush">#F0F5F4</SolidColorBrush>
          <SolidColorBrush x:Key="HoverBackgroundBrush">#E6F3F1</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryTextBrush">#153B39</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryTextBrush">#58706E</SolidColorBrush>
          <SolidColorBrush x:Key="TertiaryTextBrush">#718684</SolidColorBrush>
          <SolidColorBrush x:Key="BorderBrush">#D8E5E3</SolidColorBrush>
          <SolidColorBrush x:Key="DividerBrush">#E8EFEE</SolidColorBrush>
          <SolidColorBrush x:Key="InputBackgroundBrush">#FBFDFC</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessBackgroundBrush">#E8F7EE</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBackgroundBrush">#FFF3E8</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessTextBrush">#166534</SolidColorBrush>
          <SolidColorBrush x:Key="WarningTextBrush">#92400E</SolidColorBrush>
          <SolidColorBrush x:Key="DangerTextBrush">#B91C1C</SolidColorBrush>
          <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#E1F5F1" Offset="0" />
            <GradientStop Color="#F7FBFA" Offset="0.55" />
            <GradientStop Color="#FFF4EA" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBackgroundBrush">#0C1718</SolidColorBrush>
          <SolidColorBrush x:Key="CardBackgroundBrush">#122223</SolidColorBrush>
          <SolidColorBrush x:Key="ElevatedBackgroundBrush">#172A2B</SolidColorBrush>
          <SolidColorBrush x:Key="SubtleBackgroundBrush">#193031</SolidColorBrush>
          <SolidColorBrush x:Key="HoverBackgroundBrush">#203C3C</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryTextBrush">#EAF6F4</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryTextBrush">#AAC0BD</SolidColorBrush>
          <SolidColorBrush x:Key="TertiaryTextBrush">#8DA5A2</SolidColorBrush>
          <SolidColorBrush x:Key="BorderBrush">#2B4646</SolidColorBrush>
          <SolidColorBrush x:Key="DividerBrush">#233A3B</SolidColorBrush>
          <SolidColorBrush x:Key="InputBackgroundBrush">#102021</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessBackgroundBrush">#143429</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBackgroundBrush">#3A281B</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessTextBrush">#86EFAC</SolidColorBrush>
          <SolidColorBrush x:Key="WarningTextBrush">#FDBA74</SolidColorBrush>
          <SolidColorBrush x:Key="DangerTextBrush">#FCA5A5</SolidColorBrush>
          <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#153836" Offset="0" />
            <GradientStop Color="#142728" Offset="0.58" />
            <GradientStop Color="#352418" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="BrandBrush">#0D9488</SolidColorBrush>
      <SolidColorBrush x:Key="BrandHoverBrush">#0F766E</SolidColorBrush>
      <SolidColorBrush x:Key="BrandSoftBrush">#CCFBF1</SolidColorBrush>
      <SolidColorBrush x:Key="ActionBrush">#C2410C</SolidColorBrush>
      <SolidColorBrush x:Key="ActionHoverBrush">#9A3412</SolidColorBrush>
      <SolidColorBrush x:Key="SuccessBrush">#15803D</SolidColorBrush>
      <SolidColorBrush x:Key="WarningBrush">#B45309</SolidColorBrush>
      <SolidColorBrush x:Key="DangerBrush">#DC2626</SolidColorBrush>
      <SolidColorBrush x:Key="FocusRingBrush">#2DD4BF</SolidColorBrush>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #120F3D3A" />
    </Style>

    <Style Selector="Border.subtle-card">
      <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Border.inline-status">
      <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="11,9" />
    </Style>

    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrandHoverBrush}" />
    </Style>

    <Style Selector="Button.cta">
      <Setter Property="Background" Value="{DynamicResource ActionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ActionBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <Style Selector="Button.cta:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActionHoverBrush}" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    </Style>

    <Style Selector="Button.model-installed">
      <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
    </Style>

    <Style Selector="Button.feedback-loading">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
    </Style>

    <Style Selector="Button.feedback-success">
      <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
    </Style>

    <Style Selector="Button.feedback-success:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
    </Style>

    <Style Selector="Button.feedback-error">
      <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>

    <Style Selector="Button.feedback-error:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    </Style>

    <Style Selector="Button.danger-ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.danger-ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#14DC2626" />
    </Style>

    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Button.feedback-loading:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.model-installed:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="ToggleButton.pin">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style Selector="ToggleButton.pin:checked">
      <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="ToggleButton.pin:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox:focus, ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="TextBox.result-text">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="23" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.tertiary">
      <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>

    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="PathIcon.icon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>

    <Style Selector="Separator">
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>
  </Application.Styles>
</Application>
